# ============================================================
# Axe C — configuration d'environnement (COPIER en .env, jamais commité)
# Le .env est dans .gitignore : AUCUN secret dans le repo.
# En production : ces valeurs transitent par Secret Manager (rôle DevOps)
# -> variables d'env de la config Cloud Run -> code.
# ============================================================

# OBLIGATOIRE — secret JWT (>= 32 caractères, sinon le démarrage est refusé)
# Générez-en un : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# OPTIONNEL — clé API Anthropic (axe A, mode non-stub seulement)
ANTHROPIC_API_KEY=


# Origine du frontend autorisée en CORS (jamais "*")
# En prod : URL Cloud Run du frontend
FRONTEND_ORIGIN=http://localhost:5173

# Bascule pipeline : "true" = stubs en dur (défaut, axe C),
# "false" = vrais modules de l'axe A (backend/claims.py)
USE_STUBS=true

# OPTIONNEL — URL publique du backend déployé (ajoutée à la CSP connect-src)
# Exemple : https://payroll-api-xxxxx.a.run.app
BACKEND_PUBLIC_URL=

# Google Cloud : pas de cle API dans ce fichier si vous utilisez ADC.
#   Local  : gcloud auth application-default login (credentials hors du repo,
#            %APPDATA%\gcloudpplication_default_credentials.json)
#   Prod   : compte de service attache au service Cloud Run (DevOps)
# Les bibliothiques google-cloud la trouvent automatiquement.
